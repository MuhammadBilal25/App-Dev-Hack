# Copy to .env and fill in. Never commit .env.

# Per-team HMAC salt printed on the team slip (required). Forwarded to the API as DAY1_SALT.
DAY1_SALT=replace-with-team-salt

# Day 2 team salt (16 chars, Day 2 venue slip). Forwarded to the API as DAY2_SALT.
DAY2_SALT=replace-with-day2-salt

# Secret used to sign JWTs. If empty, the API generates a random one at startup.
JWT_SECRET=

# MinIO (object storage for product images and logos). Used by the minio container and passed
# to the API as S3_ACCESS_KEY / S3_SECRET_KEY. Change both for anything beyond a local demo.
MINIO_ROOT_USER=nascon
MINIO_ROOT_PASSWORD=nascon-minio-secret

# Set inside docker-compose.yml; only needed when running the API outside Docker.
# PORT=8080
# DATABASE_URL=postgres://nascon:nascon@localhost:5432/nascon
# REDIS_URL=redis://localhost:6379
# S3_ENDPOINT=http://localhost:9000      (omit to keep uploaded images in memory)
# S3_BUCKET=nascon-media
# S3_ACCESS_KEY=nascon
# S3_SECRET_KEY=nascon-minio-secret

# Test-only: raise the /api/v1 rate limit (default and contract value: 100 requests / 10 s / IP).
# API_RATE_LIMIT=100
